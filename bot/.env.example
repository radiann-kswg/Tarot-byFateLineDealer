# 錦野舞のタロット執務室 — Misskey Bot の設定
#
# このファイルを `.env` としてコピーし、値を埋めてください。
# 置き場所は次のどちらでも構いません（この順に探します）。
#   1. リポジトリ直下       … cp bot/.env.example .env
#   2. この bot/ の中       … cp bot/.env.example bot/.env
# `.env` は .gitignore 済みです。**絶対にコミットしないでください。**
# Linux では chmod 600 .env を推奨します。

# --- Misskey -----------------------------------------------------------------
# Bot を動かすインスタンスのURL（末尾のスラッシュは不要）
MISSKEY_HOST=https://example.tld

# 設定 → API → アクセストークンの手動発行。次の4つの権限だけを付けてください。
#   アカウントの情報を見る / 通知を見る / ノートを作成・削除する / ドライブを操作する
MISSKEY_TOKEN=

# 投稿の公開範囲: public | home | followers
# 既定は home（ローカルタイムラインに流れない）。実運用で問題ないと確認してから public に上げてください。
MISSKEY_VISIBILITY=home

# 占い結果を CW（内容注意）で畳むか。1 で畳む（既定）。
# 読み解きは長くなるのでタイムラインを占領しないための設定です。
# 自傷検知時の応答・おわびの定型文は、この設定にかかわらず畳みません（AGENTS.md §6.1-3）。
MISSKEY_FOLD_READING=1

# --- Anthropic ---------------------------------------------------------------
# https://platform.claude.com/ で発行。使用量アラート／上限の設定を推奨します。
ANTHROPIC_API_KEY=

# 読み解き文を生成するモデル
ANTHROPIC_MODEL=claude-opus-4-8

# 思考の深さ: low | medium | high | xhigh | max
# コストが気になるときは low に下げるのが第一手です。
ANTHROPIC_EFFORT=medium

# 出力の上限トークン数。思考トークンも含むため余裕を持たせています。
ANTHROPIC_MAX_TOKENS=8000

# --- 振る舞い ----------------------------------------------------------------
# 通知をポーリングする間隔（秒）
POLL_INTERVAL_SECONDS=30

# 同一ユーザーへの連続応答を抑えるクールダウン（秒）。0 で無効。
USER_COOLDOWN_SECONDS=60

# 返信本文の上限文字数（AGENTS.md §6.1 の目安に合わせています）
MAX_BODY_CHARS=1200

# 相談窓口のURL。AGENTS.md §6.3 の safety-block テンプレートに差し込まれ、
# 自傷・他害を検知したときに**公開投稿へそのまま載ります**。
# 既定は厚生労働省「まもろうよ こころ」。運用前に必ずリンク先を開いて確認してください。
SUPPORT_RESOURCE_URL=https://www.mhlw.go.jp/mamorouyokokoro/

# 占い結果を readings/ に保存するか（1 で有効）。readings/ は .gitignore 済み。
SAVE_READINGS=0

# --- 実行環境 ----------------------------------------------------------------
# 日本語フォントの絶対パス。空なら OS ごとの既定候補を自動で探します。
# Linux では fonts-noto-cjk の導入が必要です。見つからないと画像生成が失敗します。
TAROT_SPREAD_FONT=

# Misskey へのHTTPリクエストのタイムアウト（秒）
REQUEST_TIMEOUT_SECONDS=30
